HYDRO_REAL_ONLY=1
HYDRO_DATA_DIR=backend/real-data
HYDRO_KNOWLEDGE_FILE=backend/real-data/knowledge_graph.json

YOLO_MODEL_PATH=backend/models/tomato-v1.pt
YOLO_DEVICE=cpu

# Local question answering through installed Ollama models; no cloud fallback.
HYDRO_OLLAMA_URL=http://127.0.0.1:11434
HYDRO_LLM_MODEL=qwen3.5:4b

# Local EMQX platform value referenced by backend/config/mqtt.yaml.
TOMATO_MQTT_PASSWORD=replace-with-the-platform-mqtt-password
