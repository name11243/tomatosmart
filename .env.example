NEO4J_URI=bolt://127.0.0.1:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-password
NEO4J_DATABASE=neo4j
NEO4J_SCOPE=hydroponic

# 真实数据模式；旧演示数据隔离保存
HYDRO_REAL_ONLY=1
NEO4J_REAL_SCOPE=hydroponic-real

# Local Python deployment; Docker Compose sets its own container path.
YOLO_MODEL_PATH=backend/models/tomato-v1.pt
YOLO_DEVICE=cpu

# Local EMQX platform account; referenced by backend/config/mqtt.yaml.
TOMATO_MQTT_PASSWORD=replace-with-the-platform-mqtt-password
